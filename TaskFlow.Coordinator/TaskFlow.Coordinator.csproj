<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>TaskFlow.Coordinator</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Grpc.AspNetCore" Version="2.64.0"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\TaskFlow.Contracts\TaskFlow.Contracts.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Protobuf Include="..\TaskFlow.Contracts\Protos\worker.proto" GrpcServices="Server" Link="Protos\worker.proto" />
    </ItemGroup>

    <ItemGroup>
        <Protobuf Include="..\TaskFlow.Contracts\Protos\coordinator_query.proto" GrpcServices="Server" Link="Protos\coordinator_query.proto" />
    </ItemGroup>

</Project>
